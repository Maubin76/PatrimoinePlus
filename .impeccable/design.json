			"html": "<button class=\"ds-fab\" aria-label=\"Nouvelle opération\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></button>",
