<?xml version="1.0" encoding="utf-8"?>
<!-- Manifeste : sauvegarde cloud Android désactivée (données uniquement sur le téléphone) ; sauvegarde locale par WorkManager. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<!-- Cours publics des ETF (Yahoo Finance) : seuls des ISIN et des symboles sont envoyés. -->
	<uses-permission android:name="android.permission.INTERNET" />

	<application
		android:name=".PatrimoineApplication"
		android:allowBackup="false"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:theme="@style/Theme.PatrimoinePlus">

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:theme="@style/Theme.PatrimoinePlus.Starting"
			android:windowSoftInputMode="adjustResize">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<!-- WorkManager s'initialise à la demande, avec la configuration de l'application. -->
		<provider
			android:name="androidx.startup.InitializationProvider"
			android:authorities="${applicationId}.androidx-startup"
			android:exported="false"
			tools:node="merge">
			<meta-data
				android:name="androidx.work.WorkManagerInitializer"
				android:value="androidx.startup"
				tools:node="remove" />
		</provider>
	</application>

</manifest>
