<?xml version="1.0" encoding="utf-8"?>
<!-- Thèmes de fenêtre : fond aux couleurs de la palette (pas d'éclair blanc), et écran de démarrage. -->
<resources>
	<color name="window_background">#FFFFFFFF</color>
	<style name="Theme.PatrimoinePlus" parent="android:Theme.Material.Light.NoActionBar">
		<item name="android:windowBackground">@color/window_background</item>
	</style>

	<!-- Écran de démarrage : fond de l'appli, pastille du logo ; l'animation des chevrons prend le relais. -->
	<style name="Theme.PatrimoinePlus.Starting" parent="Theme.SplashScreen">
		<item name="windowSplashScreenBackground">@color/window_background</item>
		<item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
		<item name="postSplashScreenTheme">@style/Theme.PatrimoinePlus</item>
	</style>
</resources>
