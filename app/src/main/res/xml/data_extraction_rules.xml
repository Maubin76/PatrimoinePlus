<?xml version="1.0" encoding="utf-8"?>
<!--
	Règles d'extraction (Android 12 et plus) : rien ne part dans la sauvegarde cloud.
	Le transfert direct d'appareil à appareil (câble ou Wi-Fi local, lors d'un
	changement de téléphone) reste autorisé : il ne passe par aucun service distant.
-->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="root" path="." />
		<exclude domain="file" path="." />
		<exclude domain="database" path="." />
		<exclude domain="sharedpref" path="." />
		<exclude domain="external" path="." />
	</cloud-backup>
</data-extraction-rules>
